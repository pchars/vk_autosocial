# Copy to .env and fill in. Do not commit .env.

# Telegram bot token from @BotFather.
TELEGRAM_BOT_TOKEN=
# Owners: numeric Telegram ids, comma-separated (get yours from @userinfobot).
# Helpers are approved later from the chat, no need to list them here.
TELEGRAM_ADMIN_IDS=

# VK user token (photos, wall, groups, stories, offline).
# Optional: it can also be set from the bot, "Моя страница ВК" -> "Обновить доступ к ВК".
VK_TOKEN=

# Optional settings with their defaults.
# VK_API_VERSION=5.199
# DATA_DIR=data
# TEXTS_FILE=db_text.txt
# LOG_LEVEL=info
# TIMEZONE=Europe/Moscow
# AUTOFILL_INTERVAL_MIN=30
